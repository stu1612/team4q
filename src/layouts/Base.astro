---
import "../styles/global.css";
import SEO from "../components/SEO/index.astro";
import type { SeoEntry } from "../constants/seo";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
// Preloaded alongside the Latin-only @font-face rules in global.css — see the comment
// there. Preloading is what lets font-display: optional land the branded font on first
// paint instead of falling back, without reintroducing the swap-driven reflow.
import oswaldLatin from "@fontsource-variable/oswald/files/oswald-latin-wght-normal.woff2?url";
import sourceSans3Latin from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";

interface Props {
  seo: SeoEntry;
}

const { seo } = Astro.props;

// Global defaults — set once, never page to page (see /seo skill).
const DEFAULT_DESCRIPTION =
  "Team Fourth Quarter (T4Q) är en basketklubb i Helsingborg med herr-, dam- och ungdomslag.";
const SITE_ORIGIN = Astro.site?.href ?? "https://team4q.se";

const canonical = new URL(Astro.url.pathname, SITE_ORIGIN).href;
const description = seo.description || DEFAULT_DESCRIPTION;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" as="font" type="font/woff2" href={oswaldLatin} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={sourceSans3Latin} crossorigin="anonymous" />
    <SEO
      title={seo.title}
      description={description}
      ogImage={seo.ogImage}
      canonical={canonical}
      jsonLd={seo.jsonLd}
    />
  </head>

  <body class="flex min-h-screen flex-col">
    <!-- First focusable element, off-screen until focused. -->
    <a
      href="#main-content"
      class="absolute top-0 left-0 z-50 translate-y-[-110%] bg-black px-4 py-3 font-semibold text-white transition-transform duration-150 ease-out focus-visible:translate-y-0"
    >
      Hoppa till innehåll
    </a>

    <Nav />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
