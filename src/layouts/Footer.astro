---
// Site footer — extracted from Base.astro so nav and footer can be iterated on
// independently. Two parts: an image band (tagline + prominent social links) and the
// link grid (club, page links, contact + venues). The social links and phone number
// self-omit when their data is empty. Content stays inside the shared max-w-6xl container;
// only the band's backdrop bleeds full width. Centred below md, left-aligned from md up.
// Styled entirely with Tailwind utilities — no separate <style> block.
import { Image } from "astro:assets";
import logo from "../images/logos/t4q-logo.png";
import bandImage from "../images/fallback/teams/junior-cover.jpg";
import { CLUB_CONTACT, SOCIAL_LINKS } from "../constants/contact";
import { NAV_LINKS } from "../constants/nav";
import SocialIcon from "../components/SocialIcon.astro";

const SITE_NAME = "T4Q Helsingborg";

// Training venues, as named in the Om oss copy (Mission/index.astro).
const VENUES = ["GA Hallen", "Rydebäck", "Harlyckehallen"];

const year = new Date().getFullYear();

const FOOTER_LINK_CLASS =
  "text-white/80 hover:text-white hover:underline hover:underline-offset-3 focus-visible:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
---

<footer class="bg-black text-white">
  <div class="relative isolate overflow-hidden">
    {/* Decorative backdrop — the tagline carries the meaning. 70% scrim keeps white text
        well above 4.5:1 over any pixel. */}
    <Image
      src={bandImage}
      alt=""
      width={1600}
      height={600}
      loading="lazy"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-black/70"></div>

    <div
      class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-4 py-10 text-center md:flex-row md:items-end md:justify-between md:py-16 md:text-left"
    >
      <div class="flex flex-col items-center gap-3 md:items-start">
        <p class="m-0 font-display text-4xl font-extrabold uppercase text-white md:text-6xl">Mer än basket.</p>
        <p class="m-0 max-w-[46ch] text-body text-white/85 md:text-lg">
          En gemenskap i Helsingborg sedan 2016 — för barn, ungdomar och seniorer.
        </p>
      </div>

      {
        SOCIAL_LINKS.length > 0 && (
          <div class="flex flex-col items-center gap-3 md:items-start">
            <h2 class="m-0 font-display text-label uppercase text-white">Följ oss @team4q</h2>
            <ul class="m-0 flex list-none gap-3 p-0">
              {SOCIAL_LINKS.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="inline-flex h-12 w-12 items-center justify-center border border-white/40 text-white transition-colors hover:border-white hover:bg-white hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-reduce:transition-none"
                    aria-label={s.label}
                    rel="me noopener"
                    target="_blank"
                  >
                    <SocialIcon network={s.network} size={22} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>

  <div class="mx-auto grid max-w-6xl justify-items-center gap-10 px-4 py-10 text-center md:grid-cols-2 md:justify-items-stretch md:text-left md:py-14 lg:grid-cols-[2fr_1fr_1fr]">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <div class="flex items-center gap-3">
        <Image src={logo} alt="" width={65} height={64} loading="lazy" />
        <p class="m-0 hidden font-display text-h4 uppercase tracking-wide text-white md:block">Team Fourth Quarter</p>
      </div>
      <p class="m-0 max-w-[40ch] text-small text-white/80">
        Basketklubb i Helsingborg med herrlag, damlag och ungdomsverksamhet.
      </p>
    </div>

    <nav aria-label="Sidfot">
      <ul class="m-0 grid list-none grid-cols-2 gap-x-6 gap-y-2 p-0">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class={`text-small ${FOOTER_LINK_CLASS}`}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <ul class="m-0 flex list-none flex-col gap-2 p-0 text-small">
        <li>
          <a href={`mailto:${CLUB_CONTACT.email}`} class={FOOTER_LINK_CLASS}>{CLUB_CONTACT.email}</a>
        </li>
        {
          CLUB_CONTACT.phone && (
            <li>
              <a href={`tel:${CLUB_CONTACT.phone.replace(/\s+/g, "")}`} class={FOOTER_LINK_CLASS}>
                {CLUB_CONTACT.phone}
              </a>
            </li>
          )
        }
      </ul>
      <p class="m-0 mt-6 mb-2 font-display text-label uppercase text-white">Hallar</p>
      <p class="m-0 text-small text-white/80">{VENUES.join(" · ")}</p>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-2 px-4 py-4">
      <p class="m-0 text-small text-white/70">© {year} Team Fourth Quarter · {SITE_NAME}</p>
    </div>
  </div>
</footer>
