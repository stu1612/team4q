---
import Base from "../layouts/Base.astro";
import type { SeoEntry } from "../constants/seo";

const seo: SeoEntry = {
  title: "Sidan kunde inte hittas | Team Fourth Quarter",
  description: "Sidan du letade efter finns inte längre eller har flyttat.",
  ogImage: new URL("/og-default.jpg", Astro.site ?? "https://team4q.se").href,
  jsonLd: null,
};
---

<Base seo={seo}>
  <section class="mx-auto max-w-2xl px-4 py-20 text-center">
    <p class="font-display text-display text-brand-red">404</p>
    <h1 class="mt-2 text-h1">Sidan kunde inte hittas</h1>
    <p class="mt-4 text-body">
      Sidan du letade efter finns inte längre eller har flyttat.
    </p>
    <p class="mt-8">
      <a href="/" class="underline underline-offset-4">Till startsidan</a>
    </p>
  </section>
</Base>
