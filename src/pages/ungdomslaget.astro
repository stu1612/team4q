---
import Base from "../layouts/Base.astro";
import TeamPage from "../components/TeamPage/index.astro";
import TeamIntro from "../components/TeamIntro/index.astro";
import TeamResultsList from "../components/Result/TeamResultsList.astro";
import TeamFixtureList from "../components/Fixture/TeamFixtureList.astro";
import Training from "../components/Training/index.astro";
import { SEO_STATIC } from "../constants/seo";

const TEAM_SLUG = "ungdomslaget";

// Same composition as /herrlaget and /damlaget. The youth feel comes from this team's
// TEAM_INTRO entry (tone: "youth", age-group pathway, parents' checklist), not from a
// separate page layout.
//
// Section order: header → static intro → training (what most visitors come for) → matches
// → results.
//
// On-demand (ISR), same reasoning as the homepage: upcoming fixtures and result staleness
// depend on the current time, which a prerendered page would freeze at build.
export const prerender = false;
---

<Base seo={SEO_STATIC.team.juniors}>
  <TeamPage teamSlug={TEAM_SLUG} />
  <TeamIntro teamSlug={TEAM_SLUG} />
  <Training teamSlug={TEAM_SLUG} />
  <TeamFixtureList teamSlug={TEAM_SLUG} />
  <TeamResultsList teamSlug={TEAM_SLUG} />
</Base>
