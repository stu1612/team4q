---
// One place that branches on an already-resolved VM image value: a local build-time
// import (ImageMetadata, from fallback.ts) or a remote Hygraph URL (string). Astro's
// <Image> can't take the union in a single call, so the branch lives here rather than
// in every component template.
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width: number;
  height: number;
  loading?: "lazy" | "eager";
  class?: string;
}

const { src, alt, width, height, loading, class: className } = Astro.props;
---

{
  typeof src === "string" ? (
    <Image src={src} alt={alt} width={width} height={height} loading={loading} class={className} />
  ) : (
    <Image src={src} alt={alt} width={width} height={height} loading={loading} class={className} />
  )
}
