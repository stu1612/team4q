---
// Homepage mosaic — latest result, sponsor commercial slot, contact CTA and the two social
// follow tiles in one compact grid (replaces the full-width result banner and the separate
// commercial-slot row).
//
// Result and the commercial slot are both optional (no/stale result, no sponsor with a slot),
// so the layout is looked up by how many "big" tiles are present rather than fixed:
//
//   3 big   base: big tiles full width, socials 2-up
//           md:   Result spans 2 cols (2:1) / Sponsor CTA / Insta FB
//           lg:   Result (2 cols) Sponsor / CTA Insta FB
//   2 big   md+:  2×2
//   1 big   (CTA only) md: CTA spans 2 cols / Insta FB;  lg: one row of three
//
// Sponsor and Contact are news-style cards (photo on top, text on white below). Below lg
// they size themselves (16:9 photo + text). From lg they take the row's shape (square
// beside the socials) and the photo shrinks to whatever the text panel leaves, so the
// rows line up and the copy is never clipped.
//
// The socials are static constants (SOCIAL_LINKS), so they're always the "small" tiles.
import ResultTile from "./ResultTile.astro";
import SponsorTile from "./SponsorTile.astro";
import ContactTile from "./ContactTile.astro";
import SocialTile from "./SocialTile.astro";
import { getLatestResultVM } from "../Result/mappers";
import { getCommercialSlotVM } from "../CommercialSlot/mappers";
import { SOCIAL_LINKS } from "../../constants/contact";

const [result, slot] = await Promise.all([getLatestResultVM(), getCommercialSlotVM()]);

const bigCount = 1 + (result ? 1 : 0) + (slot ? 1 : 0);

// Below md every big tile is full width; the socials pair up as squares. The scoreboard is
// 4:3; the news-style cards size themselves (16:9 photo + text).
const BIG_BASE = "col-span-2 aspect-4/3";
const CARD_BASE = "col-span-2";

const LAYOUT = {
  3: {
    grid: "lg:grid-cols-3",
    // lg: no ratio, so it stretches to the Sponsor card's height in row 1.
    result: `${BIG_BASE} md:aspect-2/1 lg:aspect-auto`,
    sponsor: `${CARD_BASE} md:col-span-1 lg:aspect-square`,
    contact: `${CARD_BASE} md:col-span-1 lg:aspect-square`,
    social: "aspect-square",
  },
  2: {
    grid: "lg:grid-cols-2",
    result: `${BIG_BASE} md:col-span-1 md:aspect-auto`,
    // Half-width columns: square would be ~600px tall, so 4:3.
    sponsor: `${CARD_BASE} md:col-span-1 lg:aspect-4/3`,
    contact: `${CARD_BASE} md:col-span-1 lg:aspect-4/3`,
    social: "aspect-square md:aspect-4/3 lg:aspect-2/1",
  },
  1: {
    grid: "lg:grid-cols-3",
    result: "",
    sponsor: "",
    contact: `${CARD_BASE} lg:col-span-1 lg:aspect-square`,
    social: "aspect-square",
  },
}[bigCount]!;
---

<section aria-labelledby="mosaic-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
  <h2 id="mosaic-heading" class="sr-only">Mer från Team4Q</h2>

  <div class={`grid grid-cols-2 gap-4 md:gap-6 ${LAYOUT.grid}`}>
    {result && <ResultTile result={result} class={LAYOUT.result} />}
    {slot && <SponsorTile sponsor={slot} class={LAYOUT.sponsor} />}
    <ContactTile class={LAYOUT.contact} />
    {
      SOCIAL_LINKS.map((link) => (
        <SocialTile network={link.network} href={link.href} class={LAYOUT.social} />
      ))
    }
  </div>
</section>
