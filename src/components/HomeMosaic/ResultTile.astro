---
// Latest-result tile — the compact successor to the old full-width homepage banner. Same
// ResultVM; only the scale changed. Not a link (no results route exists).
import ResolvedImage from "../ResolvedImage.astro";
import type { ResultVM } from "../Result/types";

interface Props {
  result: ResultVM;
  /** Grid-placement classes from HomeMosaic's layout lookup. */
  class?: string;
}

const { result, class: className = "" } = Astro.props;
---

<article class={`relative isolate flex min-h-min items-end overflow-hidden rounded-card bg-black md:items-center ${className}`}>
  {/* Decorative branded backdrop — the score and teams are the text alternative. */}
  <ResolvedImage
    src={result.backgroundImage}
    alt=""
    width={1200}
    height={600}
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-top"
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(0_0_0/0.75)_0%,rgb(0_0_0/0.6)_50%,rgb(0_0_0/0.5)_100%)]" />

  <div class="flex w-full flex-col items-start gap-3 p-5 md:items-center md:p-8">
    <h3 class="sr-only">Senaste resultat</h3>
    <p class="m-0 flex items-center gap-3 font-data text-label uppercase text-white/85">
      {result.hasTeam && <span class="rounded-chip bg-brand-red px-2 py-0.5 text-white">{result.tagLabel}</span>}
      Slutresultat
    </p>

    {/* Scoreboard. Mobile: two rows, "team … score". From md: one row on a
        [1fr auto auto auto 1fr] grid, so the score sits dead centre however long either
        name is. DOM order (home, score, –, score, away) is the reading order; `order` only
        regroups the away row visually on mobile. The losing side drops to white/70 — still
        ≥ 3:1 for large text over the scrim. */}
    <p class="m-0 grid w-full grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 font-data uppercase text-white md:grid-cols-[1fr_auto_auto_auto_1fr] md:items-center md:gap-x-4">
      <span class:list={["text-xl leading-tight font-bold md:text-right md:text-2xl lg:text-3xl", result.awayWon && "text-white/70"]}>
        {result.homeTeam}
      </span>
      <span class:list={["text-4xl leading-none font-black md:text-6xl", result.awayWon && "text-white/70"]}>
        {result.homeScore}
      </span>
      <span aria-hidden="true" class="hidden text-6xl leading-none font-black text-white/70 md:block">–</span>
      <span class="sr-only">mot</span>
      <span class:list={["order-2 text-4xl leading-none font-black md:order-none md:text-6xl", result.homeWon && "text-white/70"]}>
        {result.awayScore}
      </span>
      <span class:list={["order-1 text-xl leading-tight font-bold md:order-none md:text-2xl lg:text-3xl", result.homeWon && "text-white/70"]}>
        {result.awayTeam}
      </span>
    </p>

    {result.hasDate && <p class="m-0 text-small text-white/85">{result.dateLabel}</p>}
  </div>
</article>
