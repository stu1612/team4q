---
// Sponsor commercial-slot tile — the sponsor's commercial image with their logo and
// tagline; the whole tile links to the sponsor.
import ResolvedImage from "../ResolvedImage.astro";
import type { CommercialSlotVM } from "../CommercialSlot/types";
import { CARD_SCRIM, CARD_STROKE, CARD_TEXT_SHADOW } from "../cardStyles";

interface Props {
  sponsor: CommercialSlotVM;
  /** Grid-placement classes from HomeMosaic's layout lookup. */
  class?: string;
}

const { sponsor, class: className = "" } = Astro.props;
---

<a
  href={sponsor.sponsorUrl}
  class={`group relative isolate flex min-h-min flex-col items-start justify-end overflow-hidden rounded-card bg-black p-5 md:p-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black ${CARD_TEXT_SHADOW} ${className}`}
>
  {/* Decorative backdrop — the logo's alt and the tagline carry the meaning. */}
  <ResolvedImage
    src={sponsor.image}
    alt=""
    width={1200}
    height={800}
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
  />
  <div class={`absolute inset-0 -z-10 ${CARD_SCRIM}`} />
  <span aria-hidden="true" class={CARD_STROKE}></span>
  <p class="m-0 mb-3 font-data text-label uppercase text-white/80">Partner</p>
  {/* White chip so logos of any colour stay legible on the dark scrim. The logo's alt is
      the heading's text. */}
  <h3 class="m-0 rounded-chip bg-white px-3 py-2.5">
    <ResolvedImage src={sponsor.logo} alt={sponsor.sponsorName} width={240} height={80} fit="contain" loading="lazy" class="h-8 w-auto" />
  </h3>
  {sponsor.tagline && <p class="m-0 mt-3 line-clamp-3 text-body text-white/90">{sponsor.tagline}</p>}
  <span aria-hidden="true" class="mt-4 font-data text-label uppercase text-white">Besök {sponsor.sponsorName} →</span>
</a>
