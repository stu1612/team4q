---
// "Bli en del av T4Q" contact CTA tile — mailto, the site's only contact channel.
import { Image } from "astro:assets";
import ctaImage from "../../images/fallback/news/team-news.jpg";
import { CLUB_CONTACT } from "../../constants/contact";
import { CARD_SCRIM, CARD_STROKE, CARD_TEXT_SHADOW } from "../cardStyles";

interface Props {
  /** Grid-placement classes from HomeMosaic's layout lookup. */
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<a
  href={`mailto:${CLUB_CONTACT.email}`}
  class={`group relative isolate flex min-h-min flex-col items-start justify-end overflow-hidden rounded-card bg-black p-5 md:p-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black ${CARD_TEXT_SHADOW} ${className}`}
>
  {/* Decorative backdrop — the copy carries the meaning. */}
  <Image
    src={ctaImage}
    alt=""
    width={1200}
    height={800}
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
  />
  <div class={`absolute inset-0 -z-10 ${CARD_SCRIM}`} />
  <span aria-hidden="true" class={CARD_STROKE}></span>
  <p class="m-0 mb-2 font-data text-label uppercase text-white/80">Engagera dig</p>
  <h3 class="m-0 text-balance font-heading text-xl leading-tight font-bold text-white md:text-2xl">Bli en del av T4Q</h3>
  <p class="m-0 mt-2 text-body text-white/90">
    Vill du spela, engagera dig som ledare eller synas som sponsor? Hör av dig så berättar vi mer.
  </p>
  <span class="mt-4 font-data text-label uppercase text-white">Kontakta oss →</span>
</a>
