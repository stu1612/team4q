---
// Homepage "Matcher & resultat" section — one wrapper for the upcoming fixture cards and the
// latest-result banner. Fixture and Result each keep their own data fetching and failure
// handling; this component only owns the section heading and spacing.
import Fixture from "../Fixture/index.astro";
import Result from "../Result/index.astro";
---

<section aria-labelledby="matcher-resultat-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
  <div class="mb-4 flex flex-wrap md:mb-6 items-center gap-4">
    <h2 id="matcher-resultat-heading" class="m-0 font-display text-3xl font-extrabold uppercase text-black md:text-5xl">
      Matcher & resultat
    </h2>
    <span aria-hidden="true" class="min-w-8 flex-1 border-b border-black/20"></span>
  </div>

  <div class="flex flex-col gap-8 md:gap-12">
    <Fixture />
    <Result />
  </div>
</section>
