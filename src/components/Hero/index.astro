---
import ResolvedImage from "../ResolvedImage.astro";
import { getHeroVM } from "./mappers";

const hero = await getHeroVM();
---

<section class="relative flex min-h-[clamp(28rem,70vh,44rem)] w-full items-end overflow-hidden bg-black">
  <ResolvedImage
    src={hero.coverImage}
    alt={hero.heading}
    width={2400}
    height={1350}
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover object-[50%_20%]"
  />
  <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(0_0_0/0.8)_0%,rgb(0_0_0/0.5)_55%,rgb(0_0_0/0.2)_100%)] md:bg-[linear-gradient(to_top,rgb(0_0_0/0.78)_0%,rgb(0_0_0/0.35)_38%,rgb(0_0_0/0)_70%)]"></div>

  <div class="relative mx-auto flex w-full max-w-6xl flex-col items-start gap-4 px-4 pt-4 pb-[clamp(2rem,6vw,4rem)]">
    <h1 class="m-0 max-w-[18ch] font-display text-display uppercase text-white">{hero.heading}</h1>
    {hero.hasSubheading && <p class="m-0 max-w-[46ch] text-h4 text-white/92">{hero.subheading}</p>}
    {
      hero.hasCTA && (
        <a
          class="inline-flex min-h-11 items-center bg-brand-red px-6 font-display text-label uppercase text-white no-underline hover:opacity-92 focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-white"
          href={hero.ctaUrl}
        >
          {hero.ctaLabel}
        </a>
      )
    }
  </div>
</section>
