---
// Homepage hero — full-bleed static photo with a copy entrance sequence and a "Våra lag" rail.
// Zero JS by design (load time): entrance and hover are plain CSS, and the
// scroll-out parallax uses CSS scroll-driven animations as progressive enhancement —
// browsers without `animation-timeline` simply get a static hero.
//
// Only the heading, subheading, CTA and cover image come from Hygraph (getHeroVM). The team
// links come from NAV_LINKS, so the hero adds no data fetching of its own.
import ResolvedImage from "../ResolvedImage.astro";
import { CARD_TEXT_SHADOW } from "../cardStyles";
import { NAV_LINKS } from "../../constants/nav";
import { getHeroVM } from "./mappers";

const hero = await getHeroVM();

const TEAM_LINKS = NAV_LINKS.filter((link) => link.href.endsWith("laget"));

// Entrance timing (ms). Words rise one after another; everything after them keys off the
// last word so a longer CMS heading pushes the rest back rather than overlapping.
const WORD_START = 450;
const WORD_STEP = 70;
const words = hero.heading.trim().split(/\s+/);
const afterWords = WORD_START + words.length * WORD_STEP;
---

<section
  aria-labelledby="hero-heading"
  class="hero relative isolate flex min-h-[clamp(36rem,88svh,54rem)] w-full flex-col overflow-hidden bg-black"
>
  {/* The photo itself is static — no Ken Burns zoom/drift (removed: on phones the scaling
      image visibly jumped under the finger, and an endless drift needs a pause control under
      WCAG 2.2.2). Only the scroll-out parallax below moves it. */}
  <div class="hero-parallax absolute inset-0 -z-10">
    <ResolvedImage
      src={hero.coverImage}
      alt={hero.heading}
      width={2400}
      height={1350}
      loading="eager"
      class="h-full w-full object-cover object-[50%_20%]"
    />
  </div>
  {/* Bottom scrim everywhere; from lg a left-side wash too, so the copy column stays legible
      whatever image the club uploads. Below lg the copy reaches ~70% up the hero (eyebrow),
      so the mobile scrim holds ~0.5 that high. From lg the bottom band holds ~0.6 up through
      the "Våra lag" rail on the right, which the left wash doesn't reach. */}
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(0_0_0/0.9)_0%,rgb(0_0_0/0.65)_45%,rgb(0_0_0/0.5)_75%,rgb(0_0_0/0.3)_100%)] lg:bg-[linear-gradient(to_top,rgb(0_0_0/0.85)_0%,rgb(0_0_0/0.6)_45%,rgb(0_0_0/0)_80%),linear-gradient(to_right,rgb(0_0_0/0.65)_0%,rgb(0_0_0/0.25)_45%,rgb(0_0_0/0)_70%)]"
  >
  </div>

  {/* "4Q" — Fourth Quarter — as an oversized outline mark behind the team rail. */}
  <span
    aria-hidden="true"
    class="hero-mark pointer-events-none absolute top-[-0.12em] right-[-0.04em] -z-10 hidden font-data text-[clamp(16rem,26vw,26rem)] leading-none font-bold select-none lg:block"
  >
    T4Q
  </span>

  <div class="hero-content mx-auto grid w-full max-w-6xl flex-1 items-end gap-8 px-4 pt-24 pb-8 md:pb-12 lg:grid-cols-[1fr_auto] lg:gap-16">
    <div class="flex flex-col items-start">
      <p class={`m-0 mb-5 flex items-center gap-3 font-data text-label uppercase text-white ${CARD_TEXT_SHADOW}`}>
        <span aria-hidden="true" class="hero-stroke block h-0.5 w-10 origin-left bg-brand-red" style="--d:250ms"></span>
        <span class="hero-rise" style="--d:350ms">Basket i Helsingborg · Sedan 2016</span>
      </p>

      <h1 id="hero-heading" class="m-0 max-w-[18ch] font-heading text-display text-white">
        <span class="sr-only">{hero.heading}</span>
        <span aria-hidden="true">
          {
            words.map((word, i) => (
              <>
                <span class="mb-[-0.12em] inline-block overflow-hidden pb-[0.12em] align-bottom">
                  <span class="hero-word inline-block" style={`--d:${WORD_START + i * WORD_STEP}ms`}>
                    {word}
                  </span>
                </span>{" "}
              </>
            ))
          }
        </span>
      </h1>

      {
        hero.hasSubheading && (
          <p class="hero-rise m-0 mt-5 max-w-[46ch] text-h4 text-white/90" style={`--d:${afterWords + 50}ms`}>
            {hero.subheading}
          </p>
        )
      }

      <div class="hero-rise mt-8 flex flex-wrap items-center gap-x-8 gap-y-4" style={`--d:${afterWords + 150}ms`}>
        {
          hero.hasCTA && (
            <a
              class="inline-flex min-h-12 items-center rounded-chip bg-brand-red px-7 font-data text-label uppercase text-white no-underline shadow-lg shadow-black/30 transition-[translate,box-shadow] duration-300 ease-out hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-red/30 focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-white motion-reduce:transition-none motion-reduce:hover:translate-y-0"
              href={hero.ctaUrl}
            >
              {hero.ctaLabel}
            </a>
          )
        }
        <a
          href="/traning"
          class="hero-link group inline-flex min-h-11 items-center gap-2 font-data text-label uppercase text-white no-underline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-white"
        >
          <span class="hero-underline">Se träningstider</span>
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none">→</span>
        </a>
      </div>
    </div>

    <nav aria-label="Våra lag" class={`lg:w-72 ${CARD_TEXT_SHADOW}`}>
      <p aria-hidden="true" class="hero-rise m-0 mb-3 hidden font-data text-label uppercase text-white/90 lg:block" style={`--d:${afterWords + 150}ms`}>
        Våra lag
      </p>
      <ul class="m-0 grid list-none grid-cols-3 gap-2 p-0 lg:grid-cols-1 lg:gap-3">
        {
          TEAM_LINKS.map((team, i) => (
            <li class="hero-slide" style={`--d:${afterWords + 250 + i * 90}ms`}>
              <a
                href={team.href}
                class="group relative flex min-h-12 items-center justify-center overflow-hidden rounded-chip bg-white/10 px-2 font-data text-label uppercase text-white no-underline ring-1 ring-white/20 ring-inset backdrop-blur-md focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-white lg:min-h-16 lg:justify-between lg:rounded-card lg:px-5"
              >
                {/* Red sweep — fills from the left on hover/focus; white on red is 4.77:1. */}
                <span
                  aria-hidden="true"
                  class="absolute inset-0 origin-left scale-x-0 bg-brand-red transition-transform duration-500 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100 motion-reduce:transition-none"
                />
                <span class="relative flex items-center gap-4">
                  <span aria-hidden="true" class="hidden text-white/80 transition-colors duration-500 group-hover:text-white lg:inline">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="lg:text-sm">{team.label}</span>
                </span>
                <span
                  aria-hidden="true"
                  class="relative hidden transition-transform duration-500 ease-out group-hover:translate-x-1 motion-reduce:transition-none lg:inline"
                >
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>


</section>

<style>
  /* Entrance: every animated element reads its delay from --d (set inline per element) and
     uses fill-mode `both`, so it sits in its start state until its turn. */
  .hero-stroke {
    animation: hero-draw 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) both;
  }
  .hero-word {
    animation: hero-word 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) both;
  }
  .hero-rise {
    animation: hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) both;
  }
  .hero-slide {
    animation: hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) both;
  }
  .hero-mark {
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.14);
    animation: hero-fade 2.4s ease-out 0.6s both;
  }

  /* Underline that draws in from the left on hover/focus. */
  .hero-underline {
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0% 1px;
    padding-bottom: 2px;
    transition: background-size 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-link:hover .hero-underline,
  .hero-link:focus-visible .hero-underline {
    background-size: 100% 1px;
  }

  @media (min-width: 64rem) {
    .hero-slide {
      animation-name: hero-slide;
    }
  }

  @keyframes hero-draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes hero-word {
    from {
      transform: translateY(110%);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
  @keyframes hero-slide {
    from {
      opacity: 0;
      transform: translateX(2rem);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  /* Scroll-out: as the hero leaves the viewport the photo sinks slightly (parallax) and the
     copy lifts and fades. Named view timeline on the section so its children can follow it.
     Unsupported browsers ignore the whole block. */
  @supports (animation-timeline: view()) {
    .hero {
      view-timeline-name: --hero;
    }
    .hero-parallax {
      animation: hero-sink linear both;
      animation-timeline: --hero;
      animation-range: exit 0% exit 100%;
    }
    .hero-content {
      animation: hero-lift linear both;
      animation-timeline: --hero;
      animation-range: exit 0% exit 70%;
    }
    @keyframes hero-sink {
      to {
        transform: translateY(25%);
      }
    }
    @keyframes hero-lift {
      to {
        opacity: 0;
        transform: translateY(-3rem);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stroke,
    .hero-word,
    .hero-rise,
    .hero-slide,
    .hero-mark,
    .hero-parallax,
    .hero-content {
      animation: none;
    }
    .hero-underline {
      transition: none;
    }
  }
</style>
