---
// Homepage hero — three full-bleed photos, one per team (ungdom, herr, dam), and one short
// heading + one-line subtitle in white label boxes. The photos say what T4Q is; the copy
// doesn't try to.
// Static by design: the hero is brand framing the developer owns, not content the club
// updates, so it was moved out of Hygraph (HeroModel retired 2026-10-07). No CTA, no
// motion.
//
//   <lg    "1 + 2" editorial block filling the screen under the header (phones and
//          tablets): the youth photo full width on top, herr + dam side by side below,
//          split by a 2px hairline
//   lg+    three equal portrait columns edge to edge, as one continuous band; the heading
//          is sized to stay inside the first column
//
// DOM order is the visual order at every breakpoint. Heading and subtitle sit in opaque
// white boxes, so they keep their contrast whatever the photos are.
import { Image } from "astro:assets";
import heroUngdom from "../../images/hero/hero-ungdom.jpg";
import heroHerr from "../../images/hero/hero-herr.jpg";
import heroDam from "../../images/hero/hero-dam.jpg";

const HEADING = "Mer än basket";
// TODO(club): confirm wording.
const SUBTITLE = "Helsingborgs basketklubb för alla";

// `position` keeps each photo's subject in frame as the crop changes from landscape
// (feature row) to tall portrait columns (lg+). TODO(club): replace with original,
// high-resolution club photos — hero-herr is only 1024×585 and softens on large screens.
const PHOTOS = [
  {
    src: heroUngdom,
    alt: "Ungdomsspelare i T4Q-tröjor lyssnar på tränaren under en träning",
    position: "62% 50%",
    feature: true,
  },
  {
    src: heroHerr,
    alt: "T4Q:s herrlag i en match, en spelare hoppar mot korgen",
    position: "45% 40%",
    feature: false,
  },
  {
    src: heroDam,
    alt: "T4Q:s damlag firar tillsammans i hallen efter en match",
    position: "50% 75%",
    feature: false,
  },
];
---

<section
  aria-labelledby="hero-heading"
  class="relative grid h-[calc(100svh-5rem)] max-h-[48rem] min-h-[32rem] w-full grid-cols-2 grid-rows-[3fr_2fr] gap-0.5 bg-white lg:h-[clamp(30rem,78svh,48rem)] lg:max-h-none lg:grid-cols-3 lg:grid-rows-1 lg:gap-0"
>
  {
    PHOTOS.map((photo, i) => (
      <div class:list={["relative overflow-hidden bg-black", photo.feature && "col-span-2 lg:col-span-1"]}>
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[480, 800, 1200, 1600, 2048].filter((w) => w <= photo.src.width)}
          sizes={photo.feature ? "(min-width: 64rem) 33vw, 100vw" : "(min-width: 64rem) 33vw, 50vw"}
          loading="eager"
          fetchpriority={i === 0 ? "high" : "auto"}
          class="absolute inset-0 h-full w-full object-cover"
          style={`object-position: ${photo.position}`}
        />
        {/* Soft bottom shade on every photo: grounds the white label boxes on bright images
            and gives the band depth. Purely visual — the boxes are opaque, so text contrast
            never depends on it. */}
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-black/55 via-black/20 to-transparent" />
      </div>
    ))
  }

  {/* Aligned to the site container (same left edge as the header logo). Below lg it spans
      the top 60% — the feature photo's row — so the box sits on that photo's bottom edge. */}
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[60%] lg:inset-y-0 lg:h-auto">
    <div class="mx-auto flex h-full max-w-6xl flex-col items-start justify-end gap-1 px-4 pb-5 md:pb-8 lg:pb-10">
      <h1
        id="hero-heading"
        class="m-0 bg-white px-3 py-1.5 font-heading text-[clamp(2rem,1rem+2.6vw,3.75rem)] leading-none font-bold text-black shadow-[0_8px_24px_rgb(0_0_0/0.25)] md:px-4 md:py-2"
      >
        {HEADING}
      </h1>
      <p class="m-0 max-w-[30ch] bg-white px-3 py-1 text-small text-black shadow-[0_8px_24px_rgb(0_0_0/0.25)] md:px-4 md:text-body lg:max-w-[32ch]">
        {SUBTITLE}
      </p>
    </div>
  </div>
</section>
