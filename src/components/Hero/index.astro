---
import ResolvedImage from "../ResolvedImage.astro";
import { getHeroVM } from "./mappers";

const hero = await getHeroVM();
---

<section class="hero">
  <ResolvedImage
    src={hero.coverImage}
    alt={hero.heading}
    width={2400}
    height={1350}
    loading="eager"
    class="hero__img"
  />
  <div class="hero__scrim"></div>

  <div class="hero__inner">
    <h1 class="hero__heading">{hero.heading}</h1>
    {hero.hasSubheading && <p class="hero__sub">{hero.subheading}</p>}
    {hero.hasCTA && <a class="hero__cta" href={hero.ctaUrl}>{hero.ctaLabel}</a>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: clamp(28rem, 70vh, 44rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-black);
  }

  /* The <img> is emitted by ResolvedImage (a child component), so it never carries
     this component's scope attribute — target it through the scoped .hero parent. */
  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.78) 0%,
      rgb(0 0 0 / 0.35) 38%,
      rgb(0 0 0 / 0) 70%
    );
  }

  .hero__inner {
    position: relative;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: 1rem 1rem clamp(2rem, 6vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .hero__heading {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: var(--text-display--font-weight);
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    text-transform: uppercase;
    color: var(--color-white);
  }

  .hero__sub {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    color: rgb(250 250 250 / 0.92);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.5rem;
    background: var(--color-brand-red);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
  }

  .hero__cta:hover {
    opacity: 0.92;
  }

  .hero__cta:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }
</style>
