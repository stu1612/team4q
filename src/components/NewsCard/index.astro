---
// Homepage "Nyheter" section — a fixed 5-card mosaic (not a general list; that's the
// /nyheter listing page's own, separate build later). Built directly for this one
// concrete use per the standing "no shared components yet" instruction.
//
// Mobile-first, cards square from md:
//
//   base   1 col     every card full-bleed, 4:5 portrait (image + scrim, text bottom-left)
//   md     2 cols    card1 card2 / card3 card4 / card5 spanning both columns — still all
//                    full-bleed
//   lg     3 cols    card1 card2 card3 / card4 card5 (card5 spans col2+col3). card1 and
//                    card5 stay full-bleed; 2/3/4 switch to half image / half white
//                    text panel.
//
// Achieved via plain DOM order + a single col-span-2 on card5 (from md up) — CSS Grid
// auto-placement does the rest. The "split" cards (2/3/4) are one DOM tree whose classes
// flip between the full-bleed and half/half treatments at lg, rather than two duplicated
// trees shown/hidden per breakpoint.
import ResolvedImage from "../ResolvedImage.astro";
import { CARD_SCRIM, CARD_STROKE, CARD_TEXT_SHADOW } from "../cardStyles";
import { getNewsCardVMs } from "./mappers";
import type { NewsCardVM } from "./types";

const HOMEPAGE_NEWS_COUNT = 5;
const cards = (await getNewsCardVMs()).slice(0, HOMEPAGE_NEWS_COUNT);
const [card1, card2, card3, card4, card5] = cards;

type Slot = {
  card: NewsCardVM;
  /** "bleed" = full-bleed at every breakpoint; "split" = full-bleed below lg, half image /
   *  half white panel from lg up. */
  variant: "bleed" | "split";
  wrapClass: string;
  imgWidth: number;
  imgHeight: number;
};

const slots: Slot[] = [
  { card: card1, variant: "bleed", wrapClass: "", imgWidth: 800, imgHeight: 800 },
  { card: card2, variant: "split", wrapClass: "", imgWidth: 800, imgHeight: 600 },
  { card: card3, variant: "split", wrapClass: "", imgWidth: 800, imgHeight: 600 },
  { card: card4, variant: "split", wrapClass: "", imgWidth: 800, imgHeight: 600 },
  {
    card: card5,
    variant: "bleed",
    // md: alone in row 3, spanning both columns as a 2:1 banner (about one square cell
    // tall). lg: sits beside card4 in row 2 — cancel the fixed ratio and stretch to fill
    // the row height set by card4's aspect-square instead.
    wrapClass: "md:col-span-2 md:aspect-2/1 lg:aspect-auto lg:h-full",
    imgWidth: 1600,
    imgHeight: 1000,
  },
];
---

<section aria-labelledby="nyheter-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
  <div class="mb-4 flex flex-wrap md:mb-6 items-center justify-between gap-4">
    <h2 id="nyheter-heading" class="m-0 font-heading text-3xl font-bold text-black md:text-5xl">Nyheter</h2>
    <span aria-hidden="true" class="min-w-8 flex-1 border-b border-black/20"></span>
    <a
      href="/nyheter"
      class="font-data text-small uppercase text-black hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
    >
      Se alla →
    </a>
  </div>

  {
    // Guards against a short data set (fewer than 5 items) rather than rendering a broken
    // mosaic with holes in it — render nothing until there are enough to fill it.
    cards.length === HOMEPAGE_NEWS_COUNT && (
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {slots.map(({ card, variant, wrapClass, imgWidth, imgHeight }) =>
          variant === "bleed" ? (
            <article class={`group relative isolate flex aspect-4/5 items-end overflow-hidden rounded-card bg-black md:aspect-square ${wrapClass}`}>
              <ResolvedImage
                src={card.coverImage}
                alt={card.heading}
                width={imgWidth}
                height={imgHeight}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              />
              <div class={`absolute inset-0 ${CARD_SCRIM}`} />
              {/* z-10 (not `relative`) lifts the text above the image/scrim while keeping the
                  <article> as the containing block for the heading link's stretched ::after,
                  so the whole card is clickable, not just the text block. */}
              <div class={`z-10 flex flex-col items-start p-5 md:p-6 ${CARD_TEXT_SHADOW}`}>
                {/* Red accent stroke — grows in length and thickness when the card is hovered. */}
                <span aria-hidden="true" class={CARD_STROKE}></span>
                {/* Team + date share one meta line above the heading (editorial convention). */}
                <p class="m-0 mb-2 flex flex-wrap items-center gap-x-2 font-data text-label uppercase text-white/80">
                  {card.hasTeam && (
                    <>
                      <span class="text-white">{card.tagLabel}</span>
                      <span aria-hidden="true">·</span>
                    </>
                  )}
                  <span>{card.dateLabel}</span>
                </p>
                <h3 class="m-0 text-balance font-heading text-xl leading-tight font-bold text-white md:text-2xl">
                  <a href={card.href} class="after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
                    {card.heading}
                  </a>
                </h3>
                <p class="m-0 mt-2 line-clamp-2 text-body text-white/90 text-shadow-none">{card.excerpt}</p>
                {/* Visual cue only — the heading link's stretched ::after already makes the card
                    clickable, so this is aria-hidden rather than a second link to the same URL. */}
                <span aria-hidden="true" class="mt-4 font-data text-label uppercase text-white md:hidden">Läs mer →</span>
              </div>
            </article>
          ) : (
            <article class="group relative isolate flex aspect-4/5 flex-col justify-end overflow-hidden rounded-card bg-black md:aspect-square lg:bg-white">
              {/* Below lg: absolute full-card image. From lg: a fixed in-flow top 45%, so all three
                  split cards line up whatever their copy length. */}
              <div class="absolute inset-0 lg:relative lg:inset-auto lg:basis-[45%] lg:shrink-0">
                <ResolvedImage
                  src={card.coverImage}
                  alt={card.heading}
                  width={imgWidth}
                  height={imgHeight}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                />
              </div>
              {/* Scrim only exists while the text sits over the photo (below lg). */}
              <div class={`absolute inset-0 lg:hidden ${CARD_SCRIM}`} />
              <div class={`z-10 flex flex-col items-start p-5 md:p-6 ${CARD_TEXT_SHADOW} lg:min-h-0 lg:flex-1 lg:justify-start lg:overflow-hidden lg:bg-white lg:p-5 lg:text-shadow-none`}>
                {/* Red accent stroke — grows in length and thickness when the card is hovered. */}
                <span aria-hidden="true" class={CARD_STROKE}></span>
                <p class="m-0 mb-2 flex flex-wrap items-center gap-x-2 font-data text-label uppercase text-white/80 lg:text-black/60">
                  {card.hasTeam && (
                    <>
                      <span class="text-white lg:text-black">{card.tagLabel}</span>
                      <span aria-hidden="true">·</span>
                    </>
                  )}
                  <span>{card.dateLabel}</span>
                </p>
                <h3 class="m-0 text-balance font-heading text-xl leading-tight font-bold text-white md:text-2xl lg:text-xl lg:text-black">
                  <a href={card.href} class="after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:focus-visible:outline-black">
                    {card.heading}
                  </a>
                </h3>
                {/* The half-height panel only has room for the excerpt from xl up. */}
                <p class="m-0 mt-2 line-clamp-2 text-body text-white/90 text-shadow-none lg:hidden lg:text-black/70 xl:line-clamp-2">{card.excerpt}</p>
                <span aria-hidden="true" class="mt-4 font-data text-label uppercase text-white md:hidden">Läs mer →</span>
              </div>
            </article>
          ),
        )}
      </div>
    )
  }
</section>
