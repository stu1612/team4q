---
// Homepage "Senaste resultat" section — the latest result on a full-bleed branded band.
// ResultModel is a cosmetic banner: no result, a stale one, or a failed fetch all resolve to
// null here, and the whole section (heading included) renders nothing. Independent of the
// fixtures section — see Fixture/index.astro.
import ResolvedImage from "../ResolvedImage.astro";
import { getLatestResultVM } from "./mappers";

const result = await getLatestResultVM();
---

{
  result && (
    // The section is the banner: `bg-black` is the paint while the lazy image loads (all text
    // here is white), and `isolate` + `overflow-hidden` keep the absolute layers inside it.
    // Same min-height as the Hero (Hero/index.astro) so the two bands read as a pair.
    <section
      aria-labelledby="resultat-heading"
      class="relative isolate flex min-h-[clamp(28rem,70vh,44rem)] overflow-hidden bg-black"
    >
      {/* Decorative branded backdrop — the score and teams are the text alternative. */}
      <ResolvedImage
        src={result.backgroundImage}
        alt=""
        width={2400}
        height={1600}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
      {/* Flat scrim, not a gradient: the text spans the full height (heading at the top, score
          in the middle), and 60% black keeps white text above 4.5:1 even over a pure-white
          pixel. */}
      <div class="absolute inset-0 bg-black/60" />

      {/* Column fills the band: heading pinned to the top, the score block centred in the space
          that remains. */}
      <div class="relative mx-auto flex w-full max-w-6xl flex-col px-4 py-12">
        <h2 id="resultat-heading" class="m-0 mb-6 font-display text-h2 uppercase text-white">
          Senaste resultat
        </h2>

        <div class="flex flex-1 flex-col items-center justify-center gap-3 text-center">
          {result.hasTeam && (
            <span class="bg-brand-red px-2 py-0.5 font-display text-label uppercase text-white">
              {result.tagLabel}
            </span>
          )}
          <p class="m-0 font-display text-h2 uppercase text-white md:text-h1">
            {result.homeTeam} {result.homeScore} – {result.awayScore} {result.awayTeam}
          </p>
          {result.hasDate && <p class="m-0 text-small text-white">{result.dateLabel}</p>}
        </div>
      </div>
    </section>
  )
}
