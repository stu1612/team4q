---
// Homepage latest-result banner — rendered inside FixtureResultBanner, which owns the
// visible section heading. ResultModel is a cosmetic banner: no result, a stale one, or a
// failed fetch all resolve to null here, and the banner renders nothing. Independent of the
// fixture cards — see Fixture/index.astro.
import ResolvedImage from "../ResolvedImage.astro";
import { getLatestResultVM } from "./mappers";

const result = await getLatestResultVM();
---

{
  result && (
    <div>
      {/* Screen-reader-only: keeps the h2 → h3 outline under the wrapper's visible heading. */}
      <h3 class="sr-only">Senaste resultat</h3>

      {/* Red top bar ties the banner to the fixture cards (non-text accent). */}
      <div class="relative isolate flex min-h-72 items-end justify-center overflow-hidden  bg-black md:min-h-[clamp(24rem,70vh,34rem)] md:items-center">
        {/* Decorative branded backdrop — the score and teams are the text alternative. */}
        <ResolvedImage
          src={result.backgroundImage}
          alt=""
          width={1600}
          height={640}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover object-top"
        />
        <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(0_0_0/0.75)_0%,rgb(0_0_0/0.6)_50%,rgb(0_0_0/0.5)_100%)]" />
        <div class="z-10 flex w-full flex-col items-start gap-4 p-4 md:items-center md:p-8">
          <p class="m-0 flex items-center gap-3 font-display text-label uppercase text-white/85">
            {result.hasTeam && <span class="bg-brand-red px-2 py-0.5 text-white">{result.tagLabel}</span>}
            Slutresultat
          </p>

          {/* Scoreboard. Mobile: two rows, "team … score". From md: one row on a
              [1fr auto auto auto 1fr] grid, so the score sits dead centre however long either
              name is. DOM order (home, score, –, score, away) is the reading order; `order`
              only regroups the away row visually on mobile. The losing side drops to
              white/70 — still ≥ 3:1 for large text over the scrim. */}
          <p class="m-0 grid w-full grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 font-display uppercase text-white md:grid-cols-[1fr_auto_auto_auto_1fr] md:items-center md:gap-x-6">
            <span class:list={["text-2xl font-bold md:text-right md:text-5xl", result.awayWon && "text-white/70"]}>
              {result.homeTeam}
            </span>
            <span class:list={["text-5xl leading-none font-black md:text-8xl", result.awayWon && "text-white/70"]}>
              {result.homeScore}
            </span>
            <span aria-hidden="true" class="hidden text-5xl leading-none font-black text-white/70 md:block md:text-8xl">–</span>
            <span class="sr-only">mot</span>
            <span class:list={["order-2 text-5xl leading-none font-black md:order-none md:text-8xl", result.homeWon && "text-white/70"]}>
              {result.awayScore}
            </span>
            <span class:list={["order-1 text-2xl font-bold md:order-none md:text-5xl", result.homeWon && "text-white/70"]}>
              {result.awayTeam}
            </span>
          </p>

          {result.hasDate && <p class="m-0 text-small text-white/85">{result.dateLabel}</p>}
        </div>
      </div>
    </div>
  )
}
