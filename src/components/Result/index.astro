---
// Homepage latest-result banner — rendered inside FixtureResultBanner, which owns the
// visible section heading. ResultModel is a cosmetic banner: no result, a stale one, or a
// failed fetch all resolve to null here, and the banner renders nothing. Independent of the
// fixture cards — see Fixture/index.astro.
import ResolvedImage from "../ResolvedImage.astro";
import { getLatestResultVM } from "./mappers";

const result = await getLatestResultVM();
---

{
  result && (
    <div>
      {/* Screen-reader-only: keeps the h2 → h3 outline under the wrapper's visible heading. */}
      <h3 class="sr-only">Senaste resultat</h3>

      <div class="relative isolate flex items-center justify-center overflow-hidden bg-black min-h-[clamp(24rem,70vh,34rem)]">
        {/* Decorative branded backdrop — the score and teams are the text alternative. */}
        <ResolvedImage
          src={result.backgroundImage}
          alt=""
          width={1600}
          height={640}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover object-top"
        />
        <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(0_0_0/0.75)_0%,rgb(0_0_0/0.6)_50%,rgb(0_0_0/0.5)_100%)]" />
        <div class="z-10 flex w-full flex-col items-center gap-3 p-4 md:p-8">
          {result.hasTeam && (
            <span class="bg-brand-red px-2 py-0.5 font-display text-label uppercase text-white">
              {result.tagLabel}
            </span>
          )}
          <p class="m-0 flex flex-wrap items-center justify-center gap-x-4 font-display text-6xl font-black uppercase text-white md:text-8xl">
            <span class="text-3xl font-bold md:text-5xl">{result.homeTeam}</span> {result.homeScore} – {result.awayScore} <span class="text-3xl font-bold md:text-5xl">{result.awayTeam}</span>
          </p>
          {result.hasDate && <p class="m-0 text-small text-white/85">{result.dateLabel}</p>}
        </div>
      </div>
    </div>
  )
}
