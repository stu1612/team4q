---
// Team-page "Resultat" section — a compact grid of the team's visible results as small
// scoreboards, in the homepage banner's visual language (Result/index.astro) but as
// repeating cards rather than one full-bleed hero band. No per-card photo — a grid of
// background images would be visually heavy and the brief favours restraint over density.
// Renders nothing when the team has no visible result (same "cosmetic banner, quietly
// disappears" convention as the homepage — no message block, per /graphql).
import { getResultVMsByTeam } from "./mappers";

interface Props {
  teamSlug: string;
}

const { teamSlug } = Astro.props;
const results = await getResultVMsByTeam(teamSlug);
---

{
  results.length > 0 && (
    <section id="resultat" aria-labelledby="resultat-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
      <div class="mb-4 flex flex-wrap items-center gap-4 md:mb-6">
        <h2 id="resultat-heading" class="m-0 font-display text-3xl font-extrabold uppercase text-black md:text-5xl">
          Resultat
        </h2>
        <span aria-hidden="true" class="min-w-8 flex-1 border-b border-black/20"></span>
      </div>

      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
        {results.map((result) => (
          <li>
            {/* Compact scoreboard: same language as the homepage banner (red top bar, chip ·
                SLUTRESULTAT, losing side dimmed) without the photo. Two "team ··· score"
                rows; white/60 on solid black is still ~7:1. */}
            <article class="flex h-full flex-col gap-4 border-t-4 border-brand-red bg-black p-5 text-white">
              <div class="flex items-center justify-between gap-2">
                <p class="m-0 flex items-center gap-3 font-display text-label uppercase text-white/80">
                  {result.hasTeam && <span class="bg-brand-red px-2 py-0.5 text-white">{result.tagLabel}</span>}
                  Slutresultat
                </p>
                {result.hasDate && (
                  <time datetime={result.date ?? undefined} class="text-small text-white/70">
                    {result.dateLabel}
                  </time>
                )}
              </div>

              <p class="m-0 grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 font-display uppercase">
                <span class:list={["text-xl font-bold", result.awayWon && "text-white/60"]}>{result.homeTeam}</span>
                <span class:list={["text-4xl leading-none font-black", result.awayWon && "text-white/60"]}>
                  {result.homeScore}
                </span>
                <span class="sr-only">mot</span>
                <span class:list={["text-xl font-bold", result.homeWon && "text-white/60"]}>{result.awayTeam}</span>
                <span class:list={["text-4xl leading-none font-black", result.homeWon && "text-white/60"]}>
                  {result.awayScore}
                </span>
              </p>
            </article>
          </li>
        ))}
      </ul>
    </section>
  )
}
