---
// Homepage "Våra partners" section — two independent rows grouped by the existing `tier`
// field (no new CMS field needed): main-tier sponsors larger on top, partner + community
// sponsors smaller below. Each row wraps independently so it scales past the current 6
// sponsors without the rows competing for space. This section is the site's only sponsor
// surface: `id="partners"` is the nav's "Sponsorer" target (/#partners). Built directly for
// this one use per the standing "no shared components yet" instruction.
import ResolvedImage from "../ResolvedImage.astro";
import { getSponsorGroups } from "./mappers";

const { main, featured } = await getSponsorGroups();
---

{
  (main.length > 0 || featured.length > 0) && (
    <section id="partners" aria-labelledby="partners-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
      <div class="mb-4 flex flex-wrap md:mb-6 items-center gap-4 before:hidden before:flex-1 md:justify-center md:before:block before:border-b before:border-black/20 after:flex-1 after:border-b after:border-black/20">
        <h2 id="partners-heading" class="m-0 text-left font-display text-h2 uppercase text-black md:text-center">
          Tack till våra fantastiska sponsorer som hjälper till att stödja vårt samhälle.
        </h2>
      </div>

      <div class="flex flex-col gap-8">
        {main.length > 0 && (
          <ul class="m-0 grid list-none grid-cols-2 items-center gap-6 p-0 md:flex md:flex-wrap md:justify-center md:gap-x-12 md:gap-y-8">
            {main.map((sponsor) => (
              <li class="flex h-16 w-full items-center justify-center last:odd:col-span-2 md:h-24 md:w-52">
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener"
                  class="flex h-full w-full items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
                >
                  <ResolvedImage
                    src={sponsor.logo}
                    alt={sponsor.name}
                    width={480}
                    height={240}
                    fit="contain"
                    loading="lazy"
                    class="h-full w-full object-contain"
                  />
                </a>
              </li>
            ))}
          </ul>
        )}

        {featured.length > 0 && (
          <ul class="m-0 grid list-none grid-cols-2 items-center gap-6 p-0 md:flex md:flex-wrap md:justify-center md:gap-x-10 md:gap-y-6">
            {featured.map((sponsor) => (
              <li class="flex h-14 w-full items-center justify-center last:odd:col-span-2 md:h-16 md:w-32">
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener"
                  class="flex h-full w-full items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
                >
                  <ResolvedImage
                    src={sponsor.logo}
                    alt={sponsor.name}
                    width={240}
                    height={120}
                    fit="contain"
                    loading="lazy"
                    class="h-full w-full object-contain"
                  />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
