---
// Homepage upcoming-fixture cards — rendered inside FixtureResultBanner, which owns the
// visible section heading. Independent of the result banner — see Result/index.astro.
//
// Cards are a "match ticket" — date panel + body, no image. They are not links — no
// fixtures route or per-match URL exists yet — so there is no focus state to style.
import { getUpcomingFixtureVMs } from "./mappers";

const HOMEPAGE_FIXTURE_COUNT = 3;
const result = await getUpcomingFixtureVMs(HOMEPAGE_FIXTURE_COUNT);
---

<div>
  {/* Screen-reader-only: keeps the h2 → h3 outline under the wrapper's visible heading. */}
  <h3 class="sr-only">Kommande matcher</h3>

  {
    // fetchOrFail failure: a full message block, the same visual weight as the card row it
    // replaces (per /graphql) — never stale or fake schedule data.
    !result.ok && (
      <div class="border-2 border-black bg-white p-6 md:p-8">
        <p class="m-0 max-w-[60ch] text-h4 text-black">
          Vi upplever tekniska problem. För matchinformation, kontakta oss på{" "}
          <a
            href={`mailto:${result.contact.email}`}
            class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
          >
            {result.contact.email}
          </a>
          {result.contact.phone && (
            <>
              {" "}
              eller{" "}
              <a
                href={`tel:${result.contact.phone.replace(/\s+/g, "")}`}
                class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
              >
                {result.contact.phone}
              </a>
            </>
          )}
          .
        </p>
      </div>
    )
  }

  {result.ok && result.fixtures.length === 0 && <p class="m-0 text-body text-black">Inga kommande matcher just nu.</p>}

  {
    result.ok && result.fixtures.length > 0 && (
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
        {result.fixtures.map((fixture) => (
          <li>
            {/* "Match ticket": black date panel (the thing people scan fixtures for, so the
                largest type) beside a light body. The red top bar is a non-text accent. */}
            <article class="flex h-full border-t-4 border-brand-red bg-zinc-100">
              <time
                datetime={fixture.date}
                class="flex w-22 shrink-0 flex-col items-center justify-center gap-1 bg-black px-2 py-4 font-display uppercase text-white"
              >
                <span class="text-label text-white/70">{fixture.weekdayShort}</span>
                <span class="text-6xl leading-none font-extrabold">{fixture.dayNumber}</span>
                <span class="text-label text-white/70">{fixture.monthShort}</span>
              </time>

              <div class="flex min-w-0 flex-1 flex-col gap-3 p-4">
                <div class="flex items-center justify-between gap-2">
                  {fixture.hasTeam ? (
                    <span class="bg-brand-red px-2 py-0.5 font-display text-label uppercase text-white">
                      {fixture.tagLabel}
                    </span>
                  ) : (
                    <span />
                  )}
                  <time datetime={fixture.isoDateTime} class="font-display text-2xl font-bold text-black">
                    {fixture.timeLabel}
                  </time>
                </div>

                <h3 class="m-0 flex flex-col gap-0.5 font-display text-xl font-extrabold uppercase text-black md:text-2xl">
                  <span>{fixture.homeTeam}</span>
                  <span class="font-sans text-small font-normal normal-case text-black/60">mot</span>
                  <span>{fixture.awayTeam}</span>
                </h3>

                <div class="mt-auto flex flex-col gap-0.5 border-t border-black/15 pt-3">
                  <p class="m-0 text-small text-black">{fixture.location}</p>
                  {fixture.hasAffiliation && (
                    <p class="m-0 text-small text-black/60">{fixture.affiliationName}</p>
                  )}
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    )
  }
</div>
