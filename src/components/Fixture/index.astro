---
// Homepage "Kommande matcher" section — the upcoming fixture cards. The latest result lives
// in the HomeMosaic below it.
//
// Cards are the shared "match ticket" (FixtureCard.astro). They are not links — no fixtures
// route or per-match URL exists yet — so there is no focus state to style.
import FixtureCard from "./FixtureCard.astro";
import { getUpcomingFixtureVMs } from "./mappers";

const HOMEPAGE_FIXTURE_COUNT = 3;
const result = await getUpcomingFixtureVMs(HOMEPAGE_FIXTURE_COUNT);
---

<section aria-labelledby="matcher-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
  <div class="mb-4 flex flex-wrap justify-center md:mb-6 md:justify-start items-center gap-4">
    <h2 id="matcher-heading" class="m-0 text-center font-heading text-3xl font-bold text-black md:text-left md:text-5xl">Kommande matcher</h2>
    <span aria-hidden="true" class="hidden min-w-8 flex-1 border-b border-black/20 md:block"></span>
  </div>

  {
    // fetchOrFail failure: a full message block, the same visual weight as the card row it
    // replaces (per /graphql) — never stale or fake schedule data.
    !result.ok && (
      <div class="rounded-card border border-black/10 bg-white shadow-card p-6 md:p-8">
        <p class="m-0 max-w-[60ch] text-h4 text-black">
          Vi upplever tekniska problem. För matchinformation, kontakta oss på{" "}
          <a
            href={`mailto:${result.contact.email}`}
            class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
          >
            {result.contact.email}
          </a>
          {result.contact.phone && (
            <>
              {" "}
              eller{" "}
              <a
                href={`tel:${result.contact.phone.replace(/\s+/g, "")}`}
                class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
              >
                {result.contact.phone}
              </a>
            </>
          )}
          .
        </p>
      </div>
    )
  }

  {result.ok && result.fixtures.length === 0 && <p class="m-0 text-body text-black">Inga kommande matcher just nu.</p>}

  {
    // Below md: a swipeable row that bleeds to the screen edge, each card ~85% wide so the
    // next one peeks in as the cue to swipe. From md: the usual grid. The row is a labelled,
    // focusable region so keyboard users can scroll it (the cards hold no focusable content
    // of their own); the bottom padding keeps the card shadows from being clipped by the
    // scroll container. `relative` is load-bearing: it makes the scroller the containing
    // block for the cards' absolutely-positioned sr-only text — without it those spans
    // escape the clip and widen the whole page on mobile.
    result.ok && result.fixtures.length > 0 && (
      <div
        role="region"
        aria-label="Kommande matcher"
        tabindex="0"
        class="relative -mx-4 -mb-4 snap-x snap-mandatory scroll-px-4 overflow-x-auto px-4 pt-1 pb-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black md:mx-0 md:mb-0 md:overflow-visible md:p-0"
      >
        <ul class="m-0 flex list-none gap-4 p-0 md:grid md:grid-cols-2 lg:grid-cols-3">
          {result.fixtures.map((fixture) => (
            <li class="w-[85%] shrink-0 snap-start md:w-auto">
              <FixtureCard fixture={fixture} />
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
