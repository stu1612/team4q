---
// Team-page "Kommande matcher" section — one team's upcoming fixtures, soonest first, as
// the shared match-ticket card (FixtureCard.astro). Past fixtures are left out: a played
// match is shown in the Resultat section (Result/TeamResultsList.astro), which has the score.
import FixtureCard from "./FixtureCard.astro";
import { getUpcomingFixtureVMsByTeam } from "./mappers";

interface Props {
  teamSlug: string;
}

const { teamSlug } = Astro.props;
const result = await getUpcomingFixtureVMsByTeam(teamSlug);
---

<section id="matcher" aria-labelledby="matcher-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
  <div class="mb-4 flex flex-wrap items-center gap-4 md:mb-6">
    <h2 id="matcher-heading" class="m-0 font-display text-3xl font-extrabold uppercase text-black md:text-5xl">
      Kommande matcher
    </h2>
    <span aria-hidden="true" class="min-w-8 flex-1 border-b border-black/20"></span>
  </div>

  {
    // fetchOrFail failure: a full message block (per /graphql) — never stale schedule data.
    !result.ok && (
      <div class="border-t-4 border-brand-red bg-zinc-100 p-6 md:p-8">
        <p class="m-0 max-w-[60ch] text-h4 text-black">
          Vi upplever tekniska problem. För matchinformation, kontakta oss på{" "}
          <a
            href={`mailto:${result.contact.email}`}
            class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
          >
            {result.contact.email}
          </a>
          {result.contact.phone && (
            <>
              {" "}
              eller{" "}
              <a
                href={`tel:${result.contact.phone.replace(/\s+/g, "")}`}
                class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
              >
                {result.contact.phone}
              </a>
            </>
          )}
          .
        </p>
      </div>
    )
  }

  {result.ok && result.fixtures.length === 0 && <p class="m-0 text-body text-black/70">Inga kommande matcher just nu.</p>}

  {
    result.ok && result.fixtures.length > 0 && (
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
        {result.fixtures.map((fixture) => (
          <li>
            <FixtureCard fixture={fixture} />
          </li>
        ))}
      </ul>
    )
  }
</section>
