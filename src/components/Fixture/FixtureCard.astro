---
// Match card — shared by the homepage (Fixture/index.astro) and the team pages
// (TeamFixtureList.astro) so the two can't drift apart. Crest vs crest is the focal point,
// date and time are the big line below it; no background photo and no brand red — the
// crests carry the colour, the black VS disc is the one strong accent. Both consumers only
// list upcoming fixtures — a played match is shown via ResultModel, which has the score.
import ResolvedImage from "../ResolvedImage.astro";
import type { FixtureVM } from "./types";

interface Props {
  fixture: FixtureVM;
}

const { fixture } = Astro.props;
---

<article class="flex h-full flex-col rounded-card border border-black/10 bg-white p-5 shadow-card md:p-6">
  <div class="flex min-h-6 items-center justify-between gap-2">
    {
      fixture.hasTeam ? (
        <span class="rounded-chip bg-black px-2 py-0.5 font-data text-label uppercase text-white">{fixture.tagLabel}</span>
      ) : (
        <span />
      )
    }
    {fixture.venueLabel && <span class="font-data text-label uppercase text-black/60">{fixture.venueLabel}</span>}
  </div>

  {/* Crests are alt="" — the team names directly below them are the text. Reads as
      "T4Q mot Lund Basket" to a screen reader. */}
  <h3 class="m-0 mt-5 grid grid-cols-[1fr_auto_1fr] items-start gap-3">
    <span class="flex min-w-0 flex-col items-center gap-3 text-center">
      <ResolvedImage src={fixture.homeCrest} alt="" width={160} height={160} fit="contain" class="h-14 w-14 object-contain md:h-20 md:w-20" />
      <span class="font-data text-lg leading-tight font-bold wrap-break-word uppercase text-black">{fixture.homeTeam}</span>
    </span>
    <span class="mt-3.5 flex h-9 w-9 items-center justify-center rounded-full bg-black font-data text-label uppercase text-white md:mt-5.5">
      <span aria-hidden="true">vs</span>
      <span class="sr-only">mot</span>
    </span>
    <span class="flex min-w-0 flex-col items-center gap-3 text-center">
      <ResolvedImage src={fixture.awayCrest} alt="" width={160} height={160} fit="contain" class="h-14 w-14 object-contain md:h-20 md:w-20" />
      <span class="font-data text-lg leading-tight font-bold wrap-break-word uppercase text-black">{fixture.awayTeam}</span>
    </span>
  </h3>

  <div class="mt-auto pt-6">
    <div class="flex flex-col gap-2 border-t border-black/10 pt-4">
      <p class="m-0 flex items-baseline justify-between gap-3 font-data text-2xl font-bold uppercase text-black">
        <time datetime={fixture.date}>{fixture.weekdayShort} {fixture.dayNumber} {fixture.monthShort}</time>
        <time datetime={fixture.isoDateTime}>{fixture.timeLabel}</time>
      </p>
      <p class="m-0 flex items-start gap-2 text-small text-black/70">
        <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z" />
          <circle cx="12" cy="9" r="2.5" />
        </svg>
        <span>
          <span class="sr-only">Plats: </span>
          {fixture.location}
        </span>
      </p>
      {fixture.hasAffiliation && <p class="m-0 pl-6 text-small text-black/50">{fixture.affiliationName}</p>}
    </div>
  </div>
</article>
