---
// Team-page "Träningstider" section — every active training session for one team (no date
// filtering; isActive is the sole visibility gate). Each session card carries everything
// the model has: the same date panel as the fixture tickets (FixtureCard.astro), type,
// time range, venue, notes, and each session's coach with photo, role and contact links —
// so a new player can get in touch straight from the session they want to attend.
import ResolvedImage from "../ResolvedImage.astro";
import { getTrainingVMsByTeam } from "./mappers";

interface Props {
  teamSlug: string;
}

const { teamSlug } = Astro.props;
const result = await getTrainingVMsByTeam(teamSlug);

const CONTACT_LINK_CLASS =
  "inline-flex items-center gap-2 break-all text-small text-black underline-offset-3 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black";
---

<section id="traning" aria-labelledby="traning-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
  <div class="mb-4 flex flex-wrap items-center gap-4 md:mb-6">
    <h2 id="traning-heading" class="m-0 font-display text-3xl font-extrabold uppercase text-black md:text-5xl">
      Träningstider
    </h2>
    <span aria-hidden="true" class="min-w-8 flex-1 border-b border-black/20"></span>
  </div>
  <p class="m-0 mb-6 max-w-[60ch] text-body text-black/80 md:mb-8">
    Vill du testa en träning? Hör av dig till tränaren för passet innan du kommer, så vet vi att
    du är på väg.
  </p>

  {
    // fetchOrFail failure: a full message block (per /graphql) — never stale schedule data.
    !result.ok && (
      <div class="border-t-4 border-brand-red bg-zinc-100 p-6 md:p-8">
        <p class="m-0 max-w-[60ch] text-h4 text-black">
          Vi upplever tekniska problem. För träningsinformation, kontakta oss på{" "}
          <a
            href={`mailto:${result.contact.email}`}
            class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
          >
            {result.contact.email}
          </a>
          {result.contact.phone && (
            <>
              {" "}
              eller{" "}
              <a
                href={`tel:${result.contact.phone.replace(/\s+/g, "")}`}
                class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
              >
                {result.contact.phone}
              </a>
            </>
          )}
          .
        </p>
      </div>
    )
  }

  {result.ok && result.sessions.length === 0 && <p class="m-0 text-body text-black">Inga träningstider just nu.</p>}

  {
    result.ok && result.sessions.length > 0 && (
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
        {result.sessions.map((session) => (
          <li>
            <article class="flex h-full border-t-4 border-brand-red bg-zinc-100">
              <time
                datetime={session.date}
                class="flex w-22 shrink-0 flex-col items-center justify-center gap-1 bg-black px-2 py-4 font-display uppercase text-white"
              >
                <span class="text-label text-white/75">{session.weekdayShort}</span>
                <span class="text-6xl leading-none font-extrabold">{session.dayNumber}</span>
                <span class="text-label text-white/75">{session.monthShort}</span>
              </time>

              <div class="flex min-w-0 flex-1 flex-col gap-3 p-4">
                <span class="self-start border border-black px-2 py-0.5 font-display text-label uppercase text-black">
                  {session.trainingTypeLabel}
                </span>

                <h3 class="m-0 font-display text-2xl font-bold text-black">
                  <time datetime={session.isoStart}>{session.startTime}</time>–<time datetime={session.isoEnd}>{session.endTime}</time>
                </h3>

                <p class="m-0 flex items-start gap-2 text-small text-black">
                  <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z" />
                    <circle cx="12" cy="9" r="2.5" />
                  </svg>
                  <span>
                    <span class="sr-only">Plats: </span>
                    {session.venue}
                  </span>
                </p>

                {session.information && (
                  <p class="m-0 border-l-2 border-brand-red pl-3 text-small text-black/80">{session.information}</p>
                )}

                {session.hasCoaches && (
                  <ul class="m-0 mt-auto flex list-none flex-col gap-4 border-t border-black/15 p-0 pt-4">
                    {session.coaches.map((coach) => (
                      <li class="flex items-start gap-3">
                        {coach.hasCoachPhoto ? (
                          <ResolvedImage
                            src={coach.photo!}
                            alt=""
                            width={112}
                            height={112}
                            loading="lazy"
                            class="h-14 w-14 shrink-0 rounded-full bg-white object-cover"
                          />
                        ) : (
                          <span
                            aria-hidden="true"
                            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-black font-display text-h4 uppercase text-white"
                          >
                            {coach.name.charAt(0)}
                          </span>
                        )}
                        <div class="flex min-w-0 flex-col gap-1">
                          <p class="m-0 font-display text-h4 font-bold uppercase text-black">
                            {coach.name}
                            {coach.role && (
                              <span class="ml-2 font-sans text-small font-normal normal-case text-black/60">
                                {coach.role}
                              </span>
                            )}
                          </p>
                          {coach.email && (
                            <a href={`mailto:${coach.email}`} class={CONTACT_LINK_CLASS}>
                              <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="14" rx="1" />
                                <path d="m3 7 9 6 9-6" />
                              </svg>
                              {coach.email}
                            </a>
                          )}
                          {coach.phone && (
                            <a href={coach.phoneHref} class={CONTACT_LINK_CLASS}>
                              <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z" />
                              </svg>
                              {coach.phone}
                            </a>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    )
  }
</section>
