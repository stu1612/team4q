---
// Team-page "Träningstider" section — every active training session for one team (no date
// filtering; isActive is the sole visibility gate). Each session card carries everything
// the model has: the same date panel as the fixture tickets (FixtureCard.astro), type,
// time range, venue, notes, and each session's coach with photo, role and contact links —
// so a new player can get in touch straight from the session they want to attend.
import TrainingCard from "./TrainingCard.astro";
import TrainingUnavailable from "./TrainingUnavailable.astro";
import { getTrainingVMsByTeam } from "./mappers";

interface Props {
  teamSlug: string;
}

const { teamSlug } = Astro.props;
const result = await getTrainingVMsByTeam(teamSlug);
---

<section id="traning" aria-labelledby="traning-heading" class="mx-auto max-w-6xl px-4 py-10 md:py-18">
  <div class="mb-4 flex flex-wrap items-center gap-4 md:mb-6">
    <h2 id="traning-heading" class="m-0 font-heading text-3xl font-bold text-black md:text-5xl">
      Träningstider
    </h2>
    <span aria-hidden="true" class="min-w-8 flex-1 border-b border-black/20"></span>
  </div>
  <p class="m-0 mb-6 max-w-[60ch] text-body text-black/80 md:mb-8">
    Vill du testa en träning? Hör av dig till tränaren för passet innan du kommer, så vet vi att
    du är på väg.
  </p>

  {
    // fetchOrFail failure: a full message block (per /graphql) — never stale schedule data.
    !result.ok && <TrainingUnavailable contact={result.contact} />
  }

  {result.ok && result.sessions.length === 0 && <p class="m-0 text-body text-black">Inga träningstider just nu.</p>}

  {
    result.ok && result.sessions.length > 0 && (
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
        {result.sessions.map((session) => (
          <li>
            <TrainingCard session={session} />
          </li>
        ))}
      </ul>
    )
  }
</section>
